# Force the bare domain to the canonical www host
RewriteEngine On
RewriteCond %{HTTP_HOST} ^fuevolt\.com$ [NC]
RewriteRule ^ https://www.fuevolt.com%{REQUEST_URI} [L,R=301]

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ezoic-managed ads.txt redirect disabled 29 Aug 2026 — their Incubator
  # application wasn't approved, so this domain isn't actually authorized in
  # their managed file. Left commented rather than deleted in case of a
  # future reapplication; see PROJECT_STATUS.md.
  # RewriteRule ^ads\.txt$ https://srv.adstxtmanager.com/19390/fuevolt.com [R=301,L]

  # Serve existing files directly (CSS, JS, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Redirect trailing-slash URLs to their non-trailing-slash canonical form
  # (root "/" excluded). Every page's <link rel="canonical"> already omits
  # the trailing slash, but without this redirect both /path and /path/
  # served 200 with identical content — Google indexed them as duplicates
  # and picked its own canonical instead of trusting the declared one.
  RewriteCond %{REQUEST_URI} ^/.+/$
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # Serve pre-rendered directories — if /path/index.html exists, serve it
  # This handles /guides/fuel-types-explained → /guides/fuel-types-explained/index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Also handle without trailing slash — check if adding /index.html works
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Fallback: serve root index.html for client-side routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

DirectoryIndex index.html

# Serve the TWA/Digital Asset Links verification file with the correct
# content type — Google's asset links verifier is strict about this.
<Files "assetlinks.json">
  Header set Content-Type "application/json"
</Files>

# Enable GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
